RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
BOOKING_NOTIFY_EMAIL=you@example.com
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: only needed once you can set up a Google Cloud service account.
# Without these, calendar events are skipped gracefully (appointments/emails still work).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
